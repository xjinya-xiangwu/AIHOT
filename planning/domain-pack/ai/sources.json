{
  "$comment": "AI Domain Pack 信源初稿 v0.1（D12：只收 agent-usage 相关）。json_list 字段路径按 packages/backend/src/sources/config-keys.ts；标 $draft 的配置部署时在后台'试抓'校验后修正。默认 site_fulltext/syndicate_fulltext 全关（只摘要+链接）。",
  "sources": [
    {
      "id": "json-hf-trending",
      "name": "HuggingFace Trending Models",
      "kind": "json_list",
      "config": {
        "url": "https://huggingface.co/api/models?sort=trendingScore&direction=-1&limit=30",
        "itemsPath": "$",
        "titlePaths": ["id"],
        "urlTemplate": "https://huggingface.co/{id}",
        "publishedAtPath": "createdAt",
        "publishedAtUnit": "s",
        "externalIdPath": "id",
        "_draft": "itemsPath 对根数组的写法部署时校验；可加 summaryPaths 拼接 pipeline_tag/downloads/likes"
      },
      "tier": "T1_5",
      "first_party": true,
      "owner_entity_id": "hugging-face",
      "participation_mode": "editorial",
      "interval_minutes": 180,
      "tags": ["开源模型", "P1"],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "json-civitai-weekly",
