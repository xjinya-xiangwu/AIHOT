        "urlTemplate": "https://civitai.com/models/{id}",
        "publishedAtPath": "lastVersionAt",
        "publishedAtUnit": "s",
        "externalIdPath": "id",
        "_draft": "垂域图像生成榜；对应垂域 pack 启用前可先隔离观察"
