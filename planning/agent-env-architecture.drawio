  <diagram id="agent-env-arch" name="Agent环境架构">
    <mxGraphModel dx="1420" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1360" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 标题 -->
        <mxCell id="title" value="Agent环境 — 五层架构与进化闭环（v3 · 2026-09-29）" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="640" height="30" as="geometry" />
        </mxCell>

        <!-- 专家 -->
        <mxCell id="expert" value="&lt;b&gt;专家（你）&lt;/b&gt;&lt;br&gt;判断 · 品味 · 反馈 · 决策" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="70" width="380" height="64" as="geometry" />
        </mxCell>

        <!-- L3 协同层 -->
        <mxCell id="l3" value="&lt;b&gt;L3 协同层 — 专家 × Agent 协同干活的地方（harness）&lt;/b&gt;&lt;br&gt;&lt;br&gt;✅ ZCode / Codex 会话 · 66+ 通用 skills · Agent-sync · memory&lt;br&gt;✅ wind / ifind 等 MCP 工具 · Lark 知识库（人读面）&lt;br&gt;🟡 AI-cold-start packs — soft skills 商品化（base ¥10 / ai-pm ¥19.9）&lt;br&gt;🟡 asp 安装器 — 环境部署与更新分发器（已实测 7 个 agent）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="160" y="220" width="1180" height="150" as="geometry" />
        </mxCell>

        <!-- L4 进化层 -->
